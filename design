# functions denoted by $
const sum = $x,y { x + y };  # return is implicit when omitting ;

# construct lists:
var l = [1,2,3];

# return implicitly forms a list:
return a, b, c

# destructure lists:
var a, b, c = l;

# the reason destructure doesn't have [] is common case is to destructure return values:
var a, b, c = get3();

# Objects and types, not classes


# No for loops, for streams!
for range(3) -> $x { 2*x } -> print;  # 0 2 4

# range is a built in native func (using vm api) equiv to:
const range = $n {
    var i = 0;
    ${ i += 1; if i < n { i } else { end } }  # end keyword flushes and completes the stream
};

# Example showing reading from file and collect result into a list
f = open('file.txt')
const l = for f.readLine -> toList();

const toList = ${
    l = [];
    $x { l += x; l } # result is ignored until stream ends
}
