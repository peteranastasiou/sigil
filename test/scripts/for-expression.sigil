fn range(n) {
    var i = 0;
    return fn(i) {
        i = i + 1;
        if i < n { i } else { end }   # end keyword flushes and completes the stream
    }
}

fn printIt(s) { # TODO make print a proper function which is referencable
    print(s);
}

for range -> fn(i){2*i} -> fn(i){i+1} -> printIt;

